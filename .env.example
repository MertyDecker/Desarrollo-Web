# Copia este archivo como ".env" (cp .env.example .env) y cambia los valores.
# El archivo ".env" está en .gitignore y NUNCA debe subirse a GitHub.
# Aquí solo hay valores de ejemplo, no credenciales reales.

# --- inventory ---
INVENTORY_PORT=3001
# Credenciales de la base de datos de inventory (pertenecen solo a ese servicio)
MONGO_INVENTORY_USER=inventory_app
MONGO_INVENTORY_PASSWORD=cambia-esta-clave
MONGO_INVENTORY_DB=inventory_db

# Contraseña del usuario administrador de MongoDB (solo la usa el contenedor al crearse)
MONGO_INVENTORY_ROOT_PASSWORD=cambia-esta-clave-root
