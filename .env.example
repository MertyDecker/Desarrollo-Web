# Copia este archivo como ".env" (en PowerShell: Copy-Item .env.example .env) y cambia los valores.
# El archivo ".env" está en .gitignore y NUNCA debe subirse a GitHub.
# Aquí solo hay valores de ejemplo, no credenciales reales.
#
# Los secretos de integración (claves JWT, tokens entre servicios y contraseña
# del administrador) NO van aquí: se generan en ./secrets con
#   docker run --rm -v "${PWD}:/work" -w /work node:22-alpine node scripts/generar-secretos.js

# --- Puerto público (único expuesto) ---
GATEWAY_PORT=8080
# Origen permitido para el frontend (CORS)
CORS_ORIGIN=http://localhost:5500

# --- Cuenta de administrador (la contraseña está en secrets/admin_password.txt) ---
ADMIN_EMAIL=admin@fukusuke.cl

# --- Base de datos de inventory (credenciales que usa solo ese servicio) ---
MONGO_INVENTORY_USER=inventory_app
MONGO_INVENTORY_PASSWORD=cambia-esta-clave-inventory
MONGO_INVENTORY_DB=inventory_db
MONGO_INVENTORY_ROOT_PASSWORD=cambia-esta-clave-root-inventory

# --- Base de datos de clients ---
MONGO_CLIENTS_USER=clients_app
MONGO_CLIENTS_PASSWORD=cambia-esta-clave-clients
MONGO_CLIENTS_DB=clients_db
MONGO_CLIENTS_ROOT_PASSWORD=cambia-esta-clave-root-clients

# --- Base de datos de auth ---
MONGO_AUTH_USER=auth_app
MONGO_AUTH_PASSWORD=cambia-esta-clave-auth
MONGO_AUTH_DB=auth_db
MONGO_AUTH_ROOT_PASSWORD=cambia-esta-clave-root-auth
